HOST=127.0.0.1
PORT=3001
DATA_DIR=.data
# Set to your HTTPS origin when deploying behind a reverse proxy.
# APP_ORIGIN=https://aiops.example.com
# COOKIE_SECURE=true
# Optional first administrator (otherwise use the first-run setup page).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-at-least-12-characters
# Model settings can also be configured in the administrator UI.
# MODEL_BASE_URL=https://your-provider.example.com/v1
MODEL_API_TYPE=responses # 唯一协议；已保存模型配置优先
# MODEL_NAME=your-model-name
# MODEL_API_KEY=your-api-key
# Used only when no model settings have been saved. First byte: 1-120 seconds. Stream idle: 0 or 60-600 seconds.
MODEL_FIRST_BYTE_TIMEOUT_SECONDS=90
MODEL_STREAM_IDLE_TIMEOUT_SECONDS=180

# AgentScope 2.0.8 is required; install with uv sync --project agent-worker --frozen.
# All agents use AgentScope. See docs/agentscope-runtime.md.
AGENT_RUNTIME=agentscope
# AGENTSCOPE_PYTHON=/absolute/path/to/agent-worker/.venv/bin/python
# AGENTSCOPE_AGENT_IDS has been removed. Configure enhancement scopes in the administrator UI.
# Prefork (POSIX): preload SDK, fork a fresh isolated child per run. cold starts an isolated Python process per run.
AGENTSCOPE_WORKER_MODE=prefork
AGENTSCOPE_POOL_SIZE=2
AGENTSCOPE_POOL_MAX_RUNS=100
AGENTSCOPE_POOL_MAX_AGE_MS=1800000
AGENTSCOPE_STARTUP_TIMEOUT_MS=15000
AGENTSCOPE_POOL_QUEUE_MS=30000
AGENTSCOPE_POOL_MAX_PENDING=100

# Independent optional AgentScope enhancements. Defaults preserve existing behavior.
AGENT_CONTEXT_MODE=recent
# budgeted keeps full newest turns within this UTF-8 JSON byte budget; no model summarization.
AGENT_CONTEXT_MAX_BYTES=16000
AGENT_RETRIEVAL_MODE=ranked
# diverse prefers distinct documents, then non-overlapping chunks (max 2 per document).
AGENT_EVIDENCE_REPORTS=false

# Production: required when NODE_ENV=production. See docs/production.md.
# AUTH_MODE=local
# MASTER_KEY_FILE=/run/secrets/master-key
# SETUP_TOKEN=generate-a-long-random-one-time-value
# OUTBOUND_ALLOWED_ORIGINS=https://model.example.com,https://mcp.internal.example
# OUTBOUND_PRIVATE_ORIGINS=https://mcp.internal.example
# OUTBOUND_HTTP_ORIGINS=
# TRUST_PROXY=loopback
# MODEL_DATA_POLICY=block
# HTTP_LOG=true
# METRICS_TOKEN=generate-a-separate-random-token
# Optional OTLP/HTTP JSON traces. Leave endpoint empty to disable external export.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example.com/v1/traces
# OTEL_TRACES_SAMPLE_RATE=1
# OTEL_PROPAGATE=false
# OTEL_EXPORT_TIMEOUT_MS=2000
# AUDIT_EXPORT_FILE=/app/audit/events.jsonl
# IDENTITY_GATEWAY_SECRET=only-for-AUTH_MODE-gateway-minimum-32-characters
# BACKUP_KEY_FILE=/run/secrets/backup-key
# 通知中心中的企业微信/Webhook 渠道由管理员在页面配置，沿用 OUTBOUND_* 出口规则。
# APP_ORIGIN 也用于生成消息详情链接。以下变量仅是兼容的旧执行事件出口：
# NOTIFICATION_WEBHOOK_URL=https://notify.internal.example/aiops
# NOTIFICATION_WEBHOOK_SECRET=separate-webhook-signing-secret-at-least-32-characters
# BACKUP_DIR=/var/backups/aiops
# RUNBOOK_WEBHOOK_SECRET=separate-alert-signing-secret-at-least-32-characters
# ENABLE_AUTO_REMEDIATION=false
MAX_ACTIVE_RUNS=8
MAX_USER_RUNS=2
MAX_MCP_CALLS=4
MAX_PENDING_RUNS=100
QUEUE_TIMEOUT_MS=30000
# Whole execution deadline; model streaming also uses the first-byte and idle deadlines above.
RUN_TIMEOUT_MS=420000
RUNS_PER_MINUTE=20
DAILY_RUN_LIMIT=200
RUN_TOKEN_LIMIT=100000
DAILY_TOKEN_LIMIT=1000000
WORKSPACE_DAILY_TOKEN_LIMIT=10000000
MODEL_CONTEXT_TOKENS=32768
MODEL_MAX_TOKENS=4096
# Used only when no model settings have been saved; none omits the parameter.
MODEL_TEMPERATURE=0.3
# All model requests use Responses SSE; complete JSON responses are rejected.
# 仅在排查模型请求超时/连接故障时开启；输出固定字段诊断，不包含提示词或响应正文
MODEL_DIAGNOSTICS=false
# Configure a conservative all-token price in your chosen billing currency.
MODEL_PRICE_PER_MILLION=0
DAILY_COST_LIMIT=0
APPROVAL_TTL_MS=900000
RETENTION_DAYS=90

# Default reasoning effort when no model configuration is saved: low, medium, high.
# Unset or none omits reasoning.effort for provider compatibility.
# MODEL_REASONING_EFFORT=medium
