DTS_STATUS_URL=https://dts.internal.example/proxy/v1/jobns/getstatus
DTS_ALLOW_HTTP=false
DTS_MCP_PORT=43129
DTS_MCP_TOKEN=replace_with_at_least_32_random_base64url_characters
DTS_BUSINESS_DOMAIN=general
DTS_AREA_NAME=cn_east
# allowlist（默认）：显式列出 1 至 100 个任务；region：允许业务域/区域内任意有效 ID。
DTS_JOB_SCOPE=allowlist
# region 模式清空此项。两种模式均不接受 *；任务 ID 使用原始十进制字符串。
DTS_ALLOWED_JOB_IDS=12345678901234567
DTS_TIMEOUT_MS=8000
DTS_MAX_RESPONSE_BYTES=131072
DTS_MAX_AGE_SECONDS=60
# 上游将来启用 Bearer Token 时配置；与 DTS_MCP_TOKEN 不同。
DTS_READ_TOKEN=
