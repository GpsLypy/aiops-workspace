# Terminate TLS using your organization's certificate management.
# Bind the application to loopback; do not expose its port beside the gateway.
server {
    listen 443 ssl;
    server_name aiops.example.com;
    ssl_certificate /etc/ssl/aiops/fullchain.pem;
    ssl_certificate_key /etc/ssl/aiops/privkey.pem;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Local authentication mode: strip untrusted identity headers.
        # Gateway mode must replace these with freshly signed MFA claims.
        proxy_set_header X-AIOps-Identity "";
        proxy_set_header X-AIOps-Signature "";
        proxy_buffering off;
        proxy_read_timeout 450s;
    }
    location = /metrics { deny all; }
}
