[Unit]
Description=AIOps encrypted consistent backup

[Service]
Type=oneshot
User=aiops
Group=aiops
WorkingDirectory=/opt/aiops
ExecStart=/usr/bin/node --env-file=/etc/aiops/backup.env /opt/aiops/scripts/scheduled-backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aiops /var/backups/aiops
TimeoutStartSec=15min
