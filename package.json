{
  "name": "aiops-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dts:mcp": "node --env-file=.env.dts-mcp integrations/dts-mcp/index.mjs",
    "dts:local": "node scripts/dts-local.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node scripts/test-agentscope.mjs",
    "test:agentscope": "node scripts/test-agentscope.mjs",
    "agent:check": "node scripts/check-agent-worker.mjs",
    "agent:learn:react": "node scripts/learn-agent-react.mjs",
    "agent:learn:context": "node scripts/learn-agent-context.mjs",
    "agent:learn:intent": "node scripts/learn-agent-intent.mjs",
    "agent:learn:unknown": "node scripts/learn-agent-unknown.mjs",
    "agent:learn:review": "node scripts/learn-agent-review.mjs",
    "agent:learn:trace": "node scripts/learn-agent-trace.mjs",
    "agent:benchmark": "node scripts/benchmark-agent-runtime.mjs",
    "agent:audit": "node scripts/audit-agent-worker.mjs",
    "agent:image:audit": "node scripts/audit-agent-image.mjs",
    "agent:eval": "node scripts/evaluate-agent-runtime.mjs",
    "agent:eval:dts": "node scripts/evaluate-dts-runtime.mjs",
    "agent:eval:quality": "node scripts/evaluate-quality-replay.mjs",
    "agent:review:quality": "node scripts/review-quality-replay.mjs",
    "agent:eval:saved": "node scripts/evaluate-saved-model.mjs",
    "sandbox:serve": "node integrations/agent-sandbox/service.mjs",
    "sandbox:mcp": "node integrations/agent-sandbox/mcp.mjs",
    "sandbox:accept": "node scripts/accept-agent-sandbox.mjs",
    "sandbox:control": "node integrations/agent-sandbox/control.mjs",
    "observability:accept": "node scripts/accept-observability.mjs",
    "observability:targets": "node scripts/check-observability-targets.mjs",
    "billing:reconcile": "node scripts/reconcile-model-billing.mjs",
    "agent:eval:enhancements": "node scripts/evaluate-agent-enhancements.mjs",
    "agent:acceptance": "node scripts/accept-agent-candidate.mjs",
    "agent:container": "node scripts/smoke-agent-container.mjs",
    "agent:sandbox:probe": "node scripts/probe-agent-sandbox.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check",
    "ops": "node --env-file-if-exists=.env scripts/ops.mjs",
    "verify:production": "node --test tests/security.test.mjs tests/execution.test.mjs tests/operations.test.mjs tests/scenarios.test.mjs",
    "test:load": "node scripts/load-test.mjs",
    "eval": "node --env-file-if-exists=.env scripts/evaluate.mjs",
    "test:reasoning:browser": "node scripts/reasoning-effort-browser-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:target:browser": "node scripts/target-binding-browser-smoke.mjs",
    "test:target:real": "node scripts/dts-target-real-acceptance.mjs",
    "test:streaming:browser": "node scripts/streaming-browser-smoke.mjs",
    "test:http:browser": "node scripts/http-request-id-browser-smoke.mjs",
    "test:panorama:real": "node scripts/panorama-real-acceptance.mjs",
    "test:panorama:browser": "node scripts/panorama-browser-smoke.mjs",
    "test:learning:browser": "node scripts/learning-browser-smoke.mjs",
    "test:deployment:browser": "node scripts/local-deployment-browser-smoke.mjs",
    "test:documents:browser": "node scripts/documents-browser-smoke.mjs",
    "test:review:browser": "node scripts/review-browser-smoke.mjs",
    "test:rollout:browser": "node scripts/rollout-browser-smoke.mjs",
    "test:notifications:browser": "node scripts/notification-smoke.mjs",
    "test:agent-selector:browser": "node scripts/agent-selector-browser-smoke.mjs",
    "test:chat-design:browser": "node scripts/chat-design-browser-smoke.mjs",
    "test:delegation:browser": "node scripts/delegation-browser-smoke.mjs",
    "test:delegation:runtime:browser": "node scripts/delegation-runtime-browser-smoke.mjs",
    "test:settings:browser": "node scripts/workspace-settings-browser-smoke.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "cron-parser": "^5.10.1",
    "dompurify": "^3.2.0",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "playwright": "^1.63.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GpsLypy/aiops-workspace.git"
  },
  "homepage": "https://github.com/GpsLypy/aiops-workspace#readme",
  "bugs": {
    "url": "https://github.com/GpsLypy/aiops-workspace/issues"
  }
}
